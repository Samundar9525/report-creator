.chat-container {
  width: 100%;
  max-width: 600px;
  margin: auto;
  display: flex;
  flex-direction: column;
  height: 80vh;
  border: 1px solid #ddd;
  border-radius: 12px;
  overflow: hidden;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #343541; /* Dark gray background */
}

.chat-box {
  flex: 1;
  padding: 1rem;
  overflow-y: auto;
  background: #444654; /* Slightly lighter gray for the chat box */
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.message-row {
  display: flex;
  width: 100%;
}

.user {
  justify-content: flex-end;
  text-align: right;
}

.bot {
  justify-content: flex-start;
  text-align: left;
}

.message {
  padding: 12px 18px;
  border-radius: 18px;
  max-width: 70%;
  word-wrap: break-word;
  font-size: 14px;
}

.user .message {
  background-color: #10a37f; /* ChatGPT-style greenish blue for user messages */
  color: white;
  border-bottom-right-radius: 0;
}

.bot .message {
  background-color: #f0f0f0; /* Light gray for bot responses */
  color: #333;
  border-bottom-left-radius: 0;
}

.input-container {
  display: flex;
  padding: 10px;
  border-top: 1px solid #ddd;
  background: #343541; /* Dark background to match overall UI */
}

input[type="text"] {
  flex: 1;
  padding: 12px;
  border-radius: 20px;
  border: 1px solid #ddd;
  outline: none;
  background-color: #3e4247; /* Dark input background */
  color: white;
}

button {
  margin-left: 10px;
  padding: 0 20px;
  border: none;
  background-color: #10a37f; /* Same greenish-blue as the user message bubble */
  color: white;
  border-radius: 20px;
  cursor: pointer;
}

button:hover {
  background-color: #0c8e66; /* Darker shade of the button on hover */
}
