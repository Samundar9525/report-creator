<div class="chat-container">
  <div class="chat-box">
    <div *ngFor="let msg of messages" [ngClass]="msg.sender">
      <div class="message">{{ msg.text }}</div>
    </div>
  </div>

  <div class="input-container">
    <input
      type="text"
      [(ngModel)]="inputMessage"
      (keydown.enter)="sendMessage()"
      placeholder="Type your message..."
    />
    <button (click)="sendMessage()">Send</button>
  </div>
</div>







.chat-container {
  width: 100%;
  max-width: 600px;
  margin: auto;
  display: flex;
  flex-direction: column;
  height: 80vh;
  border: 1px solid #ccc;
  border-radius: 12px;
  overflow: hidden;
  font-family: sans-serif;
}

.chat-box {
  flex: 1;
  padding: 1rem;
  overflow-y: auto;
  background: #f9f9f9;
}

.user .message {
  background-color: #0084ff;
  color: white;
  align-self: flex-end;
}

.bot .message {
  background-color: #e4e6eb;
  color: #000;
  align-self: flex-start;
}

.user,
.bot {
  display: flex;
  margin-bottom: 0.5rem;
}

.message {
  padding: 10px 14px;
  border-radius: 18px;
  max-width: 70%;
}

.input-container {
  display: flex;
  padding: 10px;
  border-top: 1px solid #ccc;
  background: white;
}

input[type="text"] {
  flex: 1;
  padding: 10px;
  border-radius: 20px;
  border: 1px solid #ccc;
  outline: none;
}

button {
  margin-left: 10px;
  padding: 0 20px;
  border: none;
  background-color: #0084ff;
  color: white;
  border-radius: 20px;
  cursor: pointer;
}



 messages: { sender: 'user' | 'bot'; text: string }[] = [];
  inputMessage = '';

  sendMessage() {
    if (!this.inputMessage.trim()) return;

    this.messages.push({ sender: 'user', text: this.inputMessage });

    // Simulate bot response
    setTimeout(() => {
      this.messages.push({ sender: 'bot', text: 'Bot response to: ' + this.inputMessage });
    }, 500);

    this.inputMessage = '';
  }
